rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Articles collection rules
    match /articles/{articleId} {
      // Allow reading a published article, or an article owned by the requester.
      // This condition applies to both `get` (single document) and `list`
      // (collection query) requests. For `list`, Firestore requires the
      // client's query to include a `where` filter that entails this
      // condition for every possible result (e.g. .where('status', '==',
      // 'published')); an unfiltered query is rejected outright, even if
      // every existing document happens to satisfy the rule.
      allow read: if resource.data.status == "published"
        || (request.auth != null && request.auth.uid == resource.data.userId);

      // Allow authenticated users to create articles (with their own userId)
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.status in ["draft", "published"]
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.content is string
        && request.resource.data.author is string
        && request.resource.data.thumbnailURL is string
        && request.resource.data.publishedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      // Allow users to update their own articles
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId;

      // Allow users to delete their own articles
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
